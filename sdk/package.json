{
  "name": "@skillmint/sdk",
  "version": "0.3.0",
  "description": "SDK for agents to discover, execute, pay (x402 + W0G), and verify AI skills on SkillMint (0G Chain). Supports prompt skills (TEE-attested inference) and agent skills (Claude/Codex folder bundles).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "skillmint",
    "0g",
    "ai-skills",
    "nft",
    "agent",
    "sdk",
    "web3"
  ],
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  }
}
